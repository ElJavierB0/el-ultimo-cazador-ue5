; Configuración del proyecto El Último Cazador (Godot 4).
config_version=5

[application]

config/name="El Último Cazador"
config/description="Plataformas 2.5D con batallas por turnos en un mundo de fantasía oscura."
config/version="0.2.0-beta"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.03, 0.03, 0.05, 1)
boot_splash/show_image=false

[autoload]

Events="*res://scripts/autoload/events.gd"
Game="*res://scripts/autoload/game.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/nunito_600.tres"

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jugador"
3d_physics/layer_3="enemigo"
3d_physics/layer_4="objetos"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.05, 1)
